# Copy to `.env.mirror-auth.local` (gitignored). Used only by:
#   npm run mirror:cloud-auth-to-local
#
# This copies **hosted Auth users** into **local/self-hosted GoTrue** with the **same user ids**
# so operators/members match cloud and Admin → Data sync can align `profiles`.
#
# Hosted: service_role from Dashboard → Settings → API (never put this in Vite / the browser).
# Local: on the **same machine** that runs Docker Compose, use Kong on loopback (the mirror
# script only allows 127.0.0.1 / localhost / *.local for the local URL):

MIRROR_CLOUD_SUPABASE_URL=https://YOUR_REF.supabase.co
MIRROR_CLOUD_SERVICE_ROLE_KEY=eyJ...service_role...

MIRROR_LOCAL_SUPABASE_URL=http://127.0.0.1:8000
MIRROR_LOCAL_SERVICE_ROLE_KEY=paste-SERVICE_ROLE_KEY-from-root-docker-.env

# Optional — password applied to every mirrored user on local (min 8 chars):
# MIRROR_LOCAL_PASSWORD=devpass123
