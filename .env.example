VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — for `npm run db:push:local` (migrations to hosted Postgres)
# SUPABASE_DB_PASSWORD=your-database-password
# Prefer pasting the Session pooler URI from Dashboard → Connect (IPv4-friendly):
# DATABASE_URL=postgresql://postgres.your-ref:YOUR_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
# Or set only password + URL above, and narrow pooler tries to your region:
# SUPABASE_POOLER_REGION=eu-west-1
