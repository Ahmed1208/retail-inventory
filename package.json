{
  "name": "retail-inventory",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/stack-up.mjs && vite",
    "dev:local": "npm run dev",
    "build": "tsc -b && vite build",
    "build:shop": "npm run generate:docker-env -- --shop-env --ensure && tsc -b && vite build --mode shop",
    "docker:dev": "docker compose up -d",
    "docker:dev:down": "docker compose down",
    "docker:shop": "docker compose --env-file .env.docker.shop up -d",
    "docker:shop:down": "docker compose --env-file .env.docker.shop down",
    "shop:up": "node scripts/stack-up.mjs --shop",
    "fresh": "node scripts/stack-up.mjs --fresh",
    "shop:fresh": "node scripts/stack-up.mjs --shop --fresh",
    "db:push": "npx supabase db push --yes",
    "db:push:local": "node scripts/db-push-from-env.mjs",
    "db:push:docker-compose": "node scripts/db-push-docker-compose.mjs",
    "functions:sync:docker": "node scripts/sync-edge-functions-docker.mjs",
    "second-pc:setup": "node scripts/second-pc-setup.mjs",
    "second-pc:update": "node scripts/second-pc-update.mjs",
    "second-pc:fresh": "node scripts/second-pc-fresh.mjs",
    "second-pc:cleanup": "node scripts/second-pc-cleanup.mjs",
    "generate:docker-env": "node scripts/generate-docker-env.mjs",
    "check:app-target": "node scripts/check-app-target.mjs",
    "check:second-pc-installs": "node scripts/check-second-pc-installs.mjs",
    "db:reset": "npx supabase db reset",
    "verify:local-login": "node scripts/verify-local-supabase-login.mjs",
    "verify:returns": "node scripts/verify-returns.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.98.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "i18next": "^25.8.14",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.577.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-i18next": "^16.5.6",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@hookform/resolvers": "^5.2.2",
    "@types/node": "^24.10.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
