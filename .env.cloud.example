# Copy this file to `.env.cloud.local` (gitignored) and fill in real values.
#
# Used when you run:
#   - `npm run dev:cloud` (Vite mode: cloud — app talks only to hosted), and
#   - `npm run dev` / `npm run build`: the same hosted URL + anon are merged as
#     `VITE_SYNC_CLOUD_URL` / `VITE_SYNC_CLOUD_ANON_KEY` for Admin → Data sync
#     (see `vite.config.ts`), so you usually do NOT duplicate them in `.env.development` or `.env.production.local`.
#
# Optional explicit sync-only keys (same project or a different hosted project):
# VITE_SYNC_CLOUD_URL=https://your-project-ref.supabase.co
# VITE_SYNC_CLOUD_ANON_KEY=your-anon-key-from-dashboard-settings-api

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-from-dashboard-settings-api
